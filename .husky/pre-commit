#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "🔍 Running pre-commit checks..."

# Run lint check
echo "📝 Checking ESLint..."
npm run lint

# Run TypeScript check
echo "🔧 Checking TypeScript..."
npx tsc --noEmit

# Run tests
echo "🧪 Running tests..."
npm test -- --watchAll=false --passWithNoTests

echo "✅ All pre-commit checks passed!"